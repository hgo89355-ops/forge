{
  "mcpServers": {
    "alpaca": {
      "type": "stdio",
      "command": "uvx",
      "args": ["alpaca-mcp-server"],
      "env": {
        "ALPACA_API_KEY": "${ALPACA_API_KEY:-proxy-injected}",
        "ALPACA_SECRET_KEY": "${ALPACA_SECRET_KEY:-proxy-injected}",
        "ALPACA_PAPER_TRADE": "${ALPACA_PAPER_TRADE:-true}"
      }
    }
  }
}
